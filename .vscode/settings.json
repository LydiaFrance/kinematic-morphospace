{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvironment": true,
  "jupyter.notebookFileRoot": "${fileDirname}",
  "jupyter.kernels.filter": [
    { "path": "/usr/local/bin/python", "type": "pythonEnvironment" },
    { "path": "/usr/local/bin/python3", "type": "pythonEnvironment" },
    { "path": "/usr/local/bin/python3.12", "type": "pythonEnvironment" },
    { "path": "/usr/bin/python", "type": "pythonEnvironment" },
    { "path": "/usr/bin/python3", "type": "pythonEnvironment" }
  ],
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true
  }
}
